{
  "name": "foliate-js",
  "version": "0.0.0",
  "description": "Render e-books in the browser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnfactotum/foliate-js.git"
  },
  "bugs": {
    "url": "https://github.com/johnfactotum/foliate-js/issues"
  },
  "homepage": "https://github.com/johnfactotum/foliate-js#readme",
  "author": "John Factotum",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./*.js": "./*.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@zip.js/zip.js": "^2.7.52",
    "fflate": "^0.8.2",
    "fs-extra": "^11.2.0",
    "globals": "^15.9.0",
    "pdfjs-dist": "^5.4.530",
    "rollup": "^4.22.4"
  },
  "scripts": {
    "build": "npx rollup -c",
    "bench:phase0": "node scripts/run-phase0-benchmark.mjs",
    "bench:phase0:baseline": "node scripts/run-phase0-benchmark.mjs --samples perf/phase0-samples.local.json --cases js --scenario continuous-reading --warmup 2 --runs 5 --trim 1 --max-cv 0.12 --max-range 0.25 --output perf/results/phase0-baseline-continuous.json",
    "bench:phase0:all": "node scripts/run-phase0-benchmark.mjs --samples perf/phase0-samples.local.json --scenario continuous-reading --warmup 2 --runs 10 --trim 1 --max-cv 0.12 --max-range 0.25 --output perf/results/phase0-latest.json",
    "bench:phase0:outline": "node scripts/run-phase0-benchmark.mjs --samples perf/phase0-samples.local.json --scenario outline-heavy --warmup 1 --runs 5 --trim 1 --max-cv 0.12 --max-range 0.25 --output perf/results/phase0-outline.json",
    "bench:phase0:jumps": "node scripts/run-phase0-benchmark.mjs --samples perf/phase0-samples.local.json --scenario jump-and-return --warmup 1 --runs 5 --trim 1 --max-cv 0.12 --max-range 0.25 --output perf/results/phase0-jumps.json"
  },
  "keywords": [
    "ebook",
    "reader",
    "epub",
    "cfi",
    "mobi",
    "azw",
    "azw3",
    "fb2",
    "cbz",
    "dictd",
    "stardict",
    "opds"
  ],
  "dependencies": {
    "construct-style-sheets-polyfill": "^3.1.0"
  }
}
